{
    "name": "shabayek/laravel-elasticsearch",
    "description": "Laravel Package For Elasticsearch Scout Engine",
    "keywords": [
        "laravel",
        "scout",
        "engine",
        "elasticsearch",
        "package"
    ],
    "homepage": "https://github.com/shabayekdes/laravel-elasticsearch",
    "license": "MIT",
    "authors": [
        {
            "name": "Esmail Shabayek",
            "email": "esmail.shabayek@gmail.com",
            "homepage": "https://github.com/shabayekdes",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "elasticsearch/elasticsearch": "^8.16 || ^9.0",
        "guzzlehttp/guzzle": "^7.2",
        "guzzlehttp/psr7": "^2.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "laravel/scout": "^10.24 || ^11.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.3 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Shabayek\\Elastic\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Shabayek\\Elastic\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-f": "vendor/bin/phpunit --filter"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shabayek\\Elastic\\Providers\\ElasticServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
